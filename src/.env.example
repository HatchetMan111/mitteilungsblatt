# Port, auf dem die App läuft
PORT=3000

# Zufälliger, langer String zur Absicherung der Sessions (unbedingt ändern!)
SESSION_SECRET=bitte-aendern-zufaelliger-string

# Nur beim allerersten Start relevant: legt den Admin-Zugang an.
# Falls ADMIN_PASSWORD leer gelassen wird, erzeugt die App automatisch ein
# zufälliges Passwort und schreibt es nach data/admin-zugangsdaten.txt
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional: eigene Verzeichnisse für Daten/Uploads/PDFs
# DATA_DIR=/opt/mitteilungsblatt/data
# UPLOAD_DIR=/opt/mitteilungsblatt/public/uploads
# PDF_DIR=/opt/mitteilungsblatt/public/pdf
