# Beispiel-Konfiguration für nginx als Reverse-Proxy vor das Mitteilungsblatt.
# HTTPS-Zertifikat separat per certbot einrichten (siehe unten).
#
# Installation:
#   apt install -y nginx certbot python3-certbot-nginx
#   cp nginx-mitteilungsblatt.conf.example /etc/nginx/sites-available/mitteilungsblatt
#   ln -s /etc/nginx/sites-available/mitteilungsblatt /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d mitteilungsblatt.beispiel-gemeinde.de
#
# certbot ergänzt die HTTPS-Konfiguration danach automatisch in dieser Datei.

server {
    listen 80;
    server_name mitteilungsblatt.beispiel-gemeinde.de;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    client_max_body_size 12m; # Bild-Uploads bis 8 MB + Formular-Overhead
}
